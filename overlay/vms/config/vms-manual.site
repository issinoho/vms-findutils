# Hand-settled configure answers for OpenVMS (VSI C, both IA64 and x86-64).
#
# Loaded after the VSI C configure answers, so values here win.  Use this for checks the
# VSI C configure run cannot answer: run-time behaviour tests (AC_RUN_IFELSE),
# compiler-feature tests, and anything it got wrong.  Give a reason
# for every entry.

# x86 CRTL has pthread_sigmask, IA64 does not.  findutils is built without threads,
# so use sigprocmask on both for identical behaviour.
ac_cv_func_pthread_sigmask=no

# configure reads byte order out of an object file in cross mode, which
# vmscc does not return.  IA64 (as used by VMS) and x86-64 are little-endian.
ac_cv_c_bigendian=no

# The CRTL's <string.h> provides mempcpy as a function-like macro (no linkable
# symbol), so configure's link test says "no"; gnulib's replacement
# declaration then collides with the macro.  Use the CRTL macro.
ac_cv_func_mempcpy=yes
gl_cv_onwards_func_mempcpy=yes


# struct sched_param is in <pthread.h> on VMS; the cross-mode configure run
# does not always ask (vms-gzip, vms-tar), so record the answer here.
ac_cv_type_struct_sched_param=yes

# gnulib's strcasecmp test is a run test with no cross-compiling answer.  It
# only tests anything in a fr_FR ISO-8859-1 locale (otherwise it keeps its
# guess, "yes" for all but Solaris and Cygwin); VSI's C RTL compares bytes
# with tolower() like any C library.
gl_cv_func_strcasecmp_works=yes

# iconv(): the VSI C RTL has it on both nodes, but conversions need tables in
# SYS$I18N_ICONV (the VMSI18N kit).  Probed 2026-10-09: x86 converts
# ISO8859-1 <-> UTF-8; IA64 has no usable tables; neither has ASCII -> UTF-8
# (the default codeset).  Settled in vms-tar; findutils makes no conversion it
# depends on.  configure cannot link-test this in the cross run, so the answer
# would otherwise be inherited from Linux.
am_cv_func_iconv=yes
am_cv_func_iconv_works=yes

# getcwd(): the CRTL's works (getcwd (NULL, 0) allocates; with
# DECC$FILENAME_UNIX_REPORT, set by vms_crtl_init.c, it returns a Unix name
# such as /DISK$USER/USERNAME/X).  The PATH_MAX test is a run test, so the cross
# run guessed "no", and gnulib's getcwd then never called it; its fallback
# walks ".." with opendir and fails with ENOENT on VMS.  That broke the
# open() of a directory, which registers the directory's name (fchdir.c), so
# vms-tar could not archive a directory.  "partly working" makes gnulib try
# the system getcwd first.  Probed 2026-10-09 (vms-tar).
gl_cv_func_getcwd_null=yes
gl_cv_func_getcwd_path_max='no, but it is partly working'

# <stdbit.h>: not in the VSI C RTL (no STDBIT module in DECC$RTLDEF.TLB; see
# crtl_modules.txt), so gnulib supplies it.  Settled here because the host
# run would otherwise find glibc's, and gnulib's stdbit.h rule then breaks:
# it substitutes NEXT_STDBIT_H ("///usr/include/stdbit.h") into an sed
# expression delimited by '/'.
ac_cv_header_stdbit_h=no

# OpenVMS Alpha (V8.4-2L2, VSI C V7.4-002): the staged config.h, generated from the IA64
# answers (configure-ia64.cache), is shared by all three architectures.  No full configure
# was run on the Alpha.  Instead every test program that the IA64 configure run sends to
# VSI C was compiled, linked or preprocessed on the node with the real compiler qualifiers
# and defines (ccflags.txt, which already has /FLOAT=IEEE_FLOAT/IEEE_MODE=DENORM_RESULTS),
# as the compile server does, in one batch job.  The programs were collected by running the
# real configure on the host against the IA64 answer memo with a recording compiler stub
# (no node needed; it reproduced configure-ia64.cache exactly, byte for byte, with no memo
# misses), so they are configure's own text with its confdefs.h.  636 distinct programs
# (652 calls, some repeated):
#   - 409 compile tests (213 ok, 196 fail): headers, declarations, types, members and the
#     compiler-feature tests behind ac_cv_c_*, gl_cv_c_* and gl_cv_header_*.
#   - 204 link tests (126 ok, 78 fail): the functions (ac_cv_func_*, gnulib's "onwards" and
#     gl_cv_func_* link checks), ac_cv_lib_* and ac_cv_search_*.
#   - 23 preprocess tests (15 ok, 8 fail).
# Result: all 636 give the same verdict on the Alpha as on the IA64 (0 differences).  For
# the 23 preprocess tests, 20 give the same text as the IA64 apart from the line markers;
# three differ only in the CRTL's system headers (extra or reordered declarations such as
# LIB$GET_CURRENT_INVO_CONTEXT and decc$setjmp1, IA64 compiler intrinsics such as __dsrlz and
# __fc in the pthread_sigmask test), which those tests (a PATH_MAX test, an lseek #error test
# and a _WIN32 test) ignore.  mempcpy, pthread_sigmask and struct sched_param are not among
# the programs for the cache: they are settled above, for all architectures.  So the one
# config.h serves IA64, x86-64 and Alpha.
# A short run-time probe (linked with the same qualifiers) agrees with the cached run-time
# answers: long, pointers, size_t, ptrdiff_t, time_t, wchar_t, wint_t and sig_atomic_t are
# 32 bits, off_t 64; size_t, wchar_t and time_t unsigned, ptrdiff_t, wint_t and
# sig_atomic_t signed; little-endian; double and float are IEEE with the exponent at
# "word 1 bit 20" and "word 0 bit 23" (gl_cv_cc_double_expbit0, gl_cv_cc_float_expbit0);
# denormals are kept (DBL_MIN/4 is not flushed) and overflow gives Infinity;
# realloc(p,0) returns NULL; open() of a directory fails with ENOENT
# (gl_cv_func_open_directory_works=no); stat() of "file/" fails; mktime() of 1970-01-01
# gives -1.  Where the Alpha is better than the cross run's guess (malloc(0) returns
# non-NULL, getcwd(NULL,0) works), gnulib then uses its own replacement, which is also what
# the IA64 and x86-64 builds use; the replacements work on every architecture.  One answer is
# a cross-mode guess that the probe does not match: gl_cv_cc_long_double_expbit0 ("word 2
# bit 0"; the Alpha's 16-byte long double has its exponent in the top 16 bits).  It is the
# same on all three architectures, is used only by gnulib's long double formatting, and
# find, xargs and locate handle no long double values, so it was left as it is.
