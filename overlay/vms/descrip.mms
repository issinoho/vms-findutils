! DESCRIP.MMS - build GNU findutils for OpenVMS (IA64, x86-64)
!
! Run from the top of the prepared source tree via [.VMS]BUILD.COM, which
! passes ARCH (IA64 or X86_64) and creates the output directories.  Source
! lists and per-object rules come from [.VMS]SOURCES.MMS, generated by tools/prepare.sh:
! SRC_OBJS is find (ftsfind.c and libfindtools), LIBFIND_OBJS findutils'
! lib/, XARGS_OBJS, LOCATE_OBJS and FRCODE_OBJS the other programs (frcode
! also links locate's word_io), EXTRA_OBJS the VMS sources.

.IFDEF ARCH
.ELSE
ARCH = IA64
.ENDIF

OBJ = [.OBJ_$(ARCH)]
LOBJ = [.OBJ_$(ARCH).LIB]
BIN = [.BIN_$(ARCH)]

.INCLUDE [.VMS]SOURCES.MMS

LIB = $(OBJ)LIBGNU.OLB

CC = CC
! LOCATE_DB: the default database (findutils' Makefile passes it with -D),
! written by [.VMS]UPDATEDB.COM (DECISIONS D3).
CFLAGS = $(CC_QUAL)/NOLIST/INCLUDE_DIRECTORY=("./","./gl/lib","./lib","./find","./locate","./vms")-
	/DEFINE=($(CC_DEFS),HAVE_CONFIG_H,"LOCATE_DB=""FINDUTILS$ROOT:[DB]LOCATEDB.""")

ALL : $(BIN)FIND.EXE, $(BIN)XARGS.EXE, $(BIN)LOCATE.EXE, $(BIN)FRCODE.EXE
	@ CONTINUE

! "-": LINK ends with a warning status (%ILINK-W-COMPWARN) when modules
! compiled with VSI C's benign warnings; tools/build.sh fails the build on
! real link errors and undefined symbols.
$(BIN)FIND.EXE : $(SRC_OBJS), $(LIBFIND_OBJS), $(EXTRA_OBJS), $(LIB)
	- LINK/EXECUTABLE=$(MMS$TARGET)/MAP=$(OBJ)FIND.MAP/FULL $(SRC_OBJS), $(LIBFIND_OBJS), $(EXTRA_OBJS), $(LIB)/LIBRARY

$(BIN)XARGS.EXE : $(XARGS_OBJS), $(LIBFIND_OBJS), $(EXTRA_OBJS), $(LIB)
	- LINK/EXECUTABLE=$(MMS$TARGET)/MAP=$(OBJ)XARGS.MAP/FULL $(XARGS_OBJS), $(LIBFIND_OBJS), $(EXTRA_OBJS), $(LIB)/LIBRARY

$(BIN)LOCATE.EXE : $(LOCATE_OBJS), $(LIBFIND_OBJS), $(EXTRA_OBJS), $(LIB)
	- LINK/EXECUTABLE=$(MMS$TARGET)/MAP=$(OBJ)LOCATE.MAP/FULL $(LOCATE_OBJS), $(LIBFIND_OBJS), $(EXTRA_OBJS), $(LIB)/LIBRARY

$(BIN)FRCODE.EXE : $(FRCODE_OBJS), $(OBJ)WORD_IO.OBJ, $(LIBFIND_OBJS), $(EXTRA_OBJS), $(LIB)
	- LINK/EXECUTABLE=$(MMS$TARGET)/MAP=$(OBJ)FRCODE.MAP/FULL $(FRCODE_OBJS), $(OBJ)WORD_IO.OBJ, $(LIBFIND_OBJS), $(EXTRA_OBJS), $(LIB)/LIBRARY

! "-": LIBRARY ends with a warning status (%LIBRAR-W-COMCOD) for modules
! compiled with warnings.
$(LIB) : $(LIB_OBJS)
	IF F$SEARCH("$(MMS$TARGET)") .EQS. "" THEN LIBRARY/CREATE/OBJECT $(MMS$TARGET)
	- LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(LOBJ)*.OBJ

CLEAN :
	IF F$SEARCH("$(LOBJ)*.*") .NES. "" THEN DELETE/NOLOG $(LOBJ)*.*;*
	IF F$SEARCH("$(OBJ)*.OBJ") .NES. "" THEN DELETE/NOLOG $(OBJ)*.OBJ;*,*.OLB;*,*.MAP;*
	IF F$SEARCH("$(BIN)*.*") .NES. "" THEN DELETE/NOLOG $(BIN)*.*;*
