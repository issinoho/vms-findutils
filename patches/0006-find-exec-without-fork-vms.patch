Subject: find/exec.c: on OpenVMS, run -exec and -ok commands without fork()

OpenVMS has no fork().  launch() runs the command as DCL in a subprocess
instead, through vms_spawn_command() (vms/vms_spawn.c; docs/DECISIONS.md
D1), so DCL verbs and foreign-command symbols work as well as images.
The subprocess starts in our default directory, so for -execdir and
-okdir launch() changes to the file's directory around it and back.
A command line too long for DCL returns 0, as for E2BIG, and
bc_do_exec() tries again with fewer arguments.

--- a/find/exec.c	2026-06-28 12:28:31.000000000 +0100
+++ b/find/exec.c	2026-10-09 19:45:07.254897719 +0100
@@ -38,6 +38,9 @@
 #include "defs.h"
 #include "fdleak.h"
 #include "system.h"
+#ifdef __VMS
+# include "vms_spawn.h"
+#endif
 
 
 /* Initialize exec->wd_for_exec.
@@ -316,6 +319,38 @@
       signal (SIGCHLD, SIG_DFL);
     }
 
+#ifdef __VMS
+  /* No fork() on OpenVMS: run the command as DCL in a subprocess
+     (vms/vms_spawn.c, docs/DECISIONS.md D1).  The subprocess starts in our
+     default directory, so for -execdir change to the file's directory
+     around it.  */
+  int ex;
+  child_pid = 0;
+  {
+    struct saved_cwd here;
+    int rc;
+    if (0 != save_cwd (&here))
+      error (EXIT_FAILURE, errno, _("Failed to save working directory"));
+    assert (NULL != execp->wd_for_exec);
+    if (!prep_child_for_exec (false, execp->wd_for_exec))
+      rc = 1;
+    else if (bc_args_exceed_testing_limit (argv))
+      rc = VMS_SPAWN_TOO_LONG;
+    else
+      rc = vms_spawn_command ("FIND", argv, execp->close_stdin);
+    if (0 != restore_cwd (&here))
+      error (EXIT_FAILURE, errno, _("Failed to restore working directory"));
+    free_cwd (&here);
+    if (rc == VMS_SPAWN_TOO_LONG)
+      return 0;                 /* E2BIG: bc_do_exec tries fewer arguments */
+    if (rc == VMS_SPAWN_FAILED)
+      {
+        error (0, errno, "%s", safely_quote_err_filename (0, argv[0]));
+        rc = 1;
+      }
+    ex = rc;
+  }
+#else
   child_pid = fork ();
   if (child_pid == -1)
     {
@@ -383,6 +418,7 @@
     }
 
   int ex = WEXITSTATUS (execp->last_child_status);
+#endif
