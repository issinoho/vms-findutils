Subject: gl/lib: open() of a directory on OpenVMS

The VMS C RTL cannot open() a directory by its Unix name and reports
ENOENT (stat() works).  As in vms-grep and vms-tar, let gnulib's open()
take its existing REPLACE_OPEN_DIRECTORY fallback (a dummy descriptor
registered with the directory's name, as on mingw) for ENOENT too; fchdir
and fdopendir then work from it.  When the name is not a directory, the
fallback keeps open()'s errno rather than setting EACCES, so a missing
file still says "No such file or directory".  gnulib's openat.c calls the
system's open() (to avoid recursing into rpl_openat); VMS has no openat(),
so there it calls rpl_open instead.

--- a/gl/lib/open.c	2026-06-24 10:56:20.000000000 +0100
+++ b/gl/lib/open.c	2026-10-09 19:26:04.786563548 +0100
@@ -189,12 +189,20 @@
      mingw), use a dummy file that behaves the same as directories
      on Linux (ie. always reports EOF on attempts to read()), and
      override fstat in fchdir.c to hide the dummy.  */
-  if (REPLACE_OPEN_DIRECTORY && fd < 0 && errno == EACCES
+  /* OpenVMS: open() of a directory by its Unix name ("dir", "dir/", ".")
+     fails with ENOENT, although stat() and opendir() succeed.  */
+# ifdef __VMS
+#  define OPEN_DIRECTORY_ERRNO(e) ((e) == EACCES || (e) == ENOENT)
+# else
+#  define OPEN_DIRECTORY_ERRNO(e) ((e) == EACCES)
+# endif
+  if (REPLACE_OPEN_DIRECTORY && fd < 0 && OPEN_DIRECTORY_ERRNO (errno)
       && ((flags & (O_ACCMODE | O_CREAT)) == O_RDONLY
           || (O_SEARCH != O_RDONLY
               && (flags & (O_ACCMODE | O_CREAT)) == O_SEARCH)))
     {
       struct stat statbuf;
+      int open_errno = errno;
       if (check_directory
           || (lstatif (filename, &statbuf, flags) == 0
               && S_ISDIR (statbuf.st_mode)))
@@ -205,7 +213,7 @@
             fd = _gl_register_fd (fd, filename);
         }
       else
-        errno = EACCES;
+        errno = open_errno;
     }
 #endif
 
--- a/gl/lib/openat.c	2026-06-24 10:56:20.000000000 +0100
+++ b/gl/lib/openat.c	2026-10-09 19:25:50.327405124 +0100
@@ -27,6 +27,15 @@
 #include <sys/types.h>
 #undef __need_system_fcntl_h
 
+#if defined __VMS && !HAVE_OPENAT
+/* OpenVMS has no openat(), so this file's open() calls cannot recurse
+   into rpl_openat.  Use gnulib's rpl_open, which can open a directory
+   (open.c, above); the C RTL's open() fails with ENOENT for one.  */
+int rpl_open (char const *filename, int flags, ...);
+# undef open
+# define open rpl_open
+#endif
+
 #if HAVE_OPENAT
 static int
 orig_openat (int fd, char const *filename, int flags, mode_t mode)
